{
  "name": "anti-vpn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,tsc,electron -c blue,yellow,green \"next dev -p 3123\" \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"wait-on tcp:3123 dist-electron/electron/main.js && electron .\"",
    "build:renderer": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run fetch-core && node scripts/copy-flags.mjs && npm run build && electron-builder --win",
    "start": "electron .",
    "fetch-core": "node scripts/fetch-core.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "postinstall": "node scripts/copy-flags.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "circle-flags": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-geo": "^3.1.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "agentation": "^3.1.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "productName": "Anti VPN",
  "description": "Anti VPN - desktop client for V2Ray, SSH, WireGuard and OpenVPN configs",
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "app.antivpn.desktop",
    "productName": "Anti VPN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "AntiVPN-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anti VPN",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}